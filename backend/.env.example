PORT=4000
NODE_ENV=development
TZ=Asia/Seoul

# 리버스 프록시(nginx 등) 뒤에 배포할 때만 설정 - 프록시 홉 수(보통 1).
# 미설정(0) 시 프록시 없음으로 간주해 req.ip를 소켓 주소 그대로 사용한다.
# 프록시 뒤인데 이 값을 비워두면 모든 사용자의 req.ip가 프록시 IP 하나로
# 고정되어 rate limit(로그인·구독·추모관 등)이 사이트 전체에 합산 적용된다.
# true로 설정하지 말 것 - X-Forwarded-For 위조로 rate limit 우회가 가능해진다.
TRUST_PROXY_HOPS=0

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ondam

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ondam-uploads
# KMS — 음성·유언 영상 등 민감 데이터 암호화 키
KMS_KEY_ID=

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Redis (BullMQ 작업 큐)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI API Keys
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# 립싱크 벤더 - LIPSYNC_PROVIDER 값 하나로 벤더 교체 (sync | musetalk | did)
LIPSYNC_PROVIDER=sync
# Sync.so API 키 (LIPSYNC_PROVIDER=sync)
SYNC_API_KEY=
# Fal.ai API 키 - MuseTalk을 Fal.ai 경유로 호출 (LIPSYNC_PROVIDER=musetalk)
FAL_API_KEY=
# D-ID API 키 (LIPSYNC_PROVIDER=did)
DID_API_KEY=

# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# 구독 자동결제
TZ=Asia/Seoul
BILLING_SCAN_CRON=0 3 * * *
BILLING_MAX_RETRIES=3
BILLING_GRACE_DAYS=3
BILLING_RETRY_INTERVAL_DAYS=1
# pending 결제 로그를 "진행 중"으로 볼 유예 시간(분). 이 시간이 지난 pending은
# stale로 간주해 같은 orderId를 재사용(reclaim)한다. 미설정/잘못된 값이면 15.
BILLING_PENDING_STALE_MINUTES=15
# 토스 자동결제(billing) API 호출 타임아웃(ms). 미설정/잘못된 값이면 30000.
TOSS_BILLING_TIMEOUT_MS=30000

# 결제 확인용 - true면 confirmPayment가 토스 API 호출 없이 즉시 완료 처리한다
# (로컬/테스트 전용). 운영 환경에는 절대 설정하지 말 것.
PAYMENT_MOCK=false
# 토스 결제 승인(confirm) API 호출 타임아웃(ms). 미설정/잘못된 값이면 30000.
TOSS_CONFIRM_TIMEOUT_MS=30000

# Coolsms (SMS 인증)
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER=

# Gmail OAuth2 (이메일 발송)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
