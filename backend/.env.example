PORT=4000
NODE_ENV=development
TZ=Asia/Seoul

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ondam

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ondam-uploads
# KMS — 음성·유언 영상 등 민감 데이터 암호화 키
KMS_KEY_ID=

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Redis (BullMQ 작업 큐)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI API Keys
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=

# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# Coolsms (SMS 인증)
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER=

# Gmail OAuth2 (이메일 발송)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
