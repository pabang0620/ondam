{
  "name": "ondam-backend",
  "version": "1.0.0",
  "description": "온담 AI 기억사진관 플랫폼 백엔드 API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "TZ=Asia/Seoul nodemon src/server.js",
    "start": "TZ=Asia/Seoul node src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/ --runInBand",
    "lint": "eslint src/",
    "workers": "TZ=Asia/Seoul node src/jobs/index.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "jest": {
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.650.0",
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@google/genai": "^1.50.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^3.1.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
