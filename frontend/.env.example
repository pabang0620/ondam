# API server URL (used by useJobSocket.js for Socket.IO connection)
# In development with Vite proxy, leave empty to use same-origin proxy.
# In production, set to the actual backend URL.
VITE_API_URL=http://localhost:4000

# 토스페이먼츠 클라이언트 키 (테스트: test_ck_xxx, 운영: live_ck_xxx)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxx

# 고객센터 전화번호 (미설정 시 관련 UI 자동 숨김)
VITE_CONTACT_PHONE=
